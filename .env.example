# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ── Azure Key Vault (optional) ─────────────────────────────────────────────────
# If set, the app fetches ONE secret (KDmonk) containing every credential in
# this file as a single JSON object, and uses it to fill in whatever is left
# blank above. Anything you keep filled in above always wins over the vault.
# Requires `az login` once on this machine (or a service principal — ask
# whoever set up the vault which one you have access via).
# AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
# AZURE_KEY_VAULT_SECRET_NAME=KDmonk

# ── 5Paisa Broker ─────────────────────────────────────────────────────────────
FIVE_PAISA_CLIENT_CODE=your_client_code
FIVE_PAISA_PASSWORD=your_password
FIVE_PAISA_DOB=DD/MM/YYYY
FIVE_PAISA_TOTP_SECRET=your_base32_totp_secret
FIVE_PAISA_APP_NAME=your_app_name
FIVE_PAISA_USER_ID=your_user_id
FIVE_PAISA_PASSWORD_KEY=your_password_key
FIVE_PAISA_ENCRYPTION_KEY=your_encryption_key

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./moneymaker.db
# For prod: DATABASE_URL=postgresql+asyncpg://user:pass@host/moneymaker

# ── Redis (optional, for multi-process message bus) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── System ────────────────────────────────────────────────────────────────────
ENV=sandbox   # sandbox | paper | live
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret_key
